# Configure these variables in the Curbwise - Development 1Password Environment.
# Mount that Environment at this repository's .env path.
# VITE_ variables are public browser configuration; never use private API keys here.

CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_GOOGLE_MAPS_API_KEY=

# PostHog browser analytics configuration (not a personal API key).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
